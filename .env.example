# Optional environment variables (never put API credentials in files you share).
# ARCIVO_HOME=C:\path\to\isolated\profile   # keep config/data in one folder (implies portable layout)
# ARCIVO_PORTABLE=1                          # force portable mode
# ARCIVO_DEMO=1                              # start the GUI with synthetic demo data
# ARCIVO_DEMO_SIZE=4000                      # number of demo messages
# ARCIVO_NO_ANIMATIONS=1                     # disable chart animations (screenshots, slow VMs)
# QT_QPA_PLATFORM=offscreen                  # headless Qt (CI)
